// Prisma schema for Assets & Software Tracker

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Authentication (NextAuth)
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  // App-specific relations
  spaces        Space[]
  settings      UserSettings?
  cloudStorages CloudStorage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// User Settings
// ============================================

model UserSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  defaultCurrency String   @default("CZK")
  scanFrequency   Int      @default(60) // minutes

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================
// Spaces (OSVČ, s.r.o., etc.)
// ============================================

model Space {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String?  @default("#6366f1") // for UI identification

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  assets      Asset[]
  software    Software[]
  invoices    Invoice[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, name])
}

// ============================================
// Assets
// ============================================

model Asset {
  id                  String           @id @default(cuid())
  name                String
  description         String?
  category            AssetCategory

  purchaseDate        DateTime
  price               Decimal          @db.Decimal(12, 2)
  currency            String           @default("CZK")

  // Depreciation
  depreciationType    DepreciationType @default(NONE)
  depreciationYears   Int?
  depreciationEndDate DateTime?

  status              AssetStatus      @default(ACTIVE)

  // Relations
  spaceId             String
  space               Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  invoiceId           String?
  invoice             Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([spaceId])
  @@index([status])
}

enum AssetCategory {
  COMPUTER
  MONITOR
  PHONE
  CAMERA
  EQUIPMENT
  FURNITURE
  SOFTWARE_LICENSE
  VEHICLE
  OTHER
}

enum DepreciationType {
  NONE
  TAX_DEPRECIATION
}

enum AssetStatus {
  ACTIVE
  FULLY_DEPRECIATED
  ARCHIVED
}

// ============================================
// Software / Subscriptions
// ============================================

model Software {
  id                String          @id @default(cuid())
  name              String
  description       String?
  category          SoftwareCategory
  url               String?

  price             Decimal         @db.Decimal(12, 2)
  currency          String          @default("CZK")
  billingPeriod     BillingPeriod

  startDate         DateTime
  nextPaymentDate   DateTime?

  status            SoftwareStatus  @default(ACTIVE)

  // Relations
  spaceId           String
  space             Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  invoices          Invoice[]       @relation("SoftwareInvoices")
  primaryInvoiceId  String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([spaceId])
  @@index([status])
  @@index([nextPaymentDate])
}

enum SoftwareCategory {
  SAAS
  HOSTING
  DOMAIN
  AI_TOOLS
  DEVELOPMENT
  DESIGN
  PRODUCTIVITY
  COMMUNICATION
  STORAGE
  SECURITY
  OTHER
}

enum BillingPeriod {
  MONTHLY
  YEARLY
  ONE_TIME
}

enum SoftwareStatus {
  ACTIVE
  CANCELLED
  ARCHIVED
}

// ============================================
// Invoices
// ============================================

model Invoice {
  id                  String         @id @default(cuid())

  // Cloud storage reference
  cloudStorageId      String?
  cloudStorage        CloudStorage?  @relation(fields: [cloudStorageId], references: [id], onDelete: SetNull)
  cloudFilePath       String?
  cloudFileId         String?
  cloudFileUrl        String?

  // Extracted/manual data
  fileName            String
  supplierName        String?
  invoiceNumber       String?
  issueDate           DateTime?
  taxableSupplyDate   DateTime?
  totalPrice          Decimal?       @db.Decimal(12, 2)
  currency            String?
  hasVat              Boolean?

  // AI extraction confidence
  extractionConfidence Float?
  rawExtractedData    Json?

  // Processing status
  status              InvoiceStatus  @default(NEW)
  processedAt         DateTime?

  // Relations
  spaceId             String?
  space               Space?         @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  assets              Asset[]
  software            Software[]     @relation("SoftwareInvoices")

  scannedFromFolderId String?
  scannedFromFolder   InvoiceFolder? @relation(fields: [scannedFromFolderId], references: [id], onDelete: SetNull)

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([status])
  @@index([cloudStorageId])
}

enum InvoiceStatus {
  NEW
  PROCESSING
  PROCESSED
  IGNORED
  ERROR
}

// ============================================
// Cloud Storage Integration
// ============================================

model CloudStorage {
  id            String            @id @default(cuid())
  name          String
  provider      CloudProvider

  accessToken   String?           @db.Text
  refreshToken  String?           @db.Text
  tokenExpiry   DateTime?

  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  invoiceFolders InvoiceFolder[]
  invoices      Invoice[]

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([userId, provider, name])
}

enum CloudProvider {
  ONEDRIVE
  GOOGLE_DRIVE
}

model InvoiceFolder {
  id              String        @id @default(cuid())

  cloudStorageId  String
  cloudStorage    CloudStorage  @relation(fields: [cloudStorageId], references: [id], onDelete: Cascade)

  folderId        String        // Provider-specific folder ID
  folderPath      String        // Human-readable path

  lastScannedAt   DateTime?
  isActive        Boolean       @default(true)

  invoices        Invoice[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([cloudStorageId, folderId])
}
